# 运行模式：development开发环境 / demo演示环境 / production生产环境
VITE_NODE_ENV = development

# 是否启用Mock数据（演示版建议开启，无需真实后端接口）
VITE_USE_MOCK = true

# 后端API地址（生产环境部署时修改为真实地址）
VITE_API_BASE_URL = https://api.trailmate.example.com

# 地图服务密钥（使用高德/百度地图时配置，演示版可留空）
VITE_MAP_KEY =

# 百度地图API密钥（静态地图、逆地理编码、地点搜索、天气等）
VITE_BAIDU_MAP_AK = your_baidu_ak_here

# AI大模型API密钥（接入真实AI服务时配置，演示版可留空）
VITE_AI_API_KEY =
# MiniMax API 配置（已废弃，请使用下方 OpenRouter）
VITE_MINIMAX_API_KEY = your_api_key_here
VITE_MINIMAX_API_URL = https://api.minimax.chat/v1
# Supabase 配置（用户认证 + 数据库）
# 前往 https://supabase.com 创建项目，在 Project Settings > API 中获取以下信息
VITE_SUPABASE_URL = https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY = your_anon_key_here

# OpenRouter API 配置（行程规划 AI 聊天）
VITE_OPENROUTER_API_KEY = OPENROUTER_KEY_PLACEHOLDER
VITE_OPENROUTER_API_URL = https://openrouter.ai/api/v1/chat/completions
