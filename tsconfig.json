{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@trailmate/core": ["./core/index.ts"],
      "@trailmate/shared/*": ["./shared/*"]
    }
  },
  "include": ["core/**/*", "modules/**/*", "shared/**/*", "adapters/**/*", "platforms/**/*", "*.d.ts"]
}