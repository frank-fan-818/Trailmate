{
  "buildCommand": "cd platforms/web && node ../../node_modules/vite/bin/vite.js build",
  "outputDirectory": "platforms/web/dist",
  "installCommand": "npm install",
  "functions": {
    "api/baidumap-proxy.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/exchange-proxy.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/exchange-proxy/latest", "destination": "/api/exchange-proxy" },
    { "source": "/api/baidumap/(.*)", "destination": "/api/baidumap-proxy" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
