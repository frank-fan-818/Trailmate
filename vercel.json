{
  "buildCommand": "cd platforms/web && node ../../node_modules/vite/bin/vite.js build",
  "outputDirectory": "platforms/web/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/baidumap/(.*)", "destination": "https://api.map.baidu.com/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
