{
    "name": "trailmate",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run dev:web",
        "dev:web": "node -e \"process.chdir('platforms/web');require('child_process').spawn('npx',['vite'],{stdio:'inherit',shell:true})\"",
        "build": "npm run build:web",
        "build:web": "node -e \"process.chdir('platforms/web');require('child_process').spawn('npx',['vite','build'],{stdio:'inherit',shell:true})\"",
        "build:core": "tsc -p core/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "evals": "node evals/run-itinerary-eval.mjs",
        "evals:test": "vitest run evals/"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.99.2",
        "@types/leaflet": "^1.9.21",
        "autoprefixer": "^10.4.27",
        "leaflet": "^1.9.4",
        "lucide-vue-next": "^1.0.0",
        "marked": "^17.0.5",
        "tailwindcss": "^3.4.19",
        "vue": "^3.4.0",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "dotenv": "^17.3.1",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vitest": "^4.1.0"
    }
}
